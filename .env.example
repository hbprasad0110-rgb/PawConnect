NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=pawconnect_app
DB_PASSWORD=replace_with_local_database_password
DB_NAME=pawconnect
DB_NAME_TEST=pawconnect_test
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

JWT_SECRET=replace_with_a_long_random_value_at_least_32_characters
ADMIN_EMAIL=admin@pawconnect.edu
ADMIN_PASSWORD=replace_with_demo_admin_password
DEMO_ADOPTER_EMAIL=sarah@example.com
DEMO_ADOPTER_PASSWORD=replace_with_demo_adopter_password

EMAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=supportpawconnect@gmail.com
SMTP_APP_PASSWORD=replace_with_google_app_password
EMAIL_FROM=PawConnect Support <supportpawconnect@gmail.com>
SUPPORT_EMAIL=supportpawconnect@gmail.com

VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_DEMO_ADMIN_EMAIL=admin@pawconnect.edu
VITE_DEMO_ADMIN_PASSWORD=replace_with_demo_admin_password
VITE_DEMO_ADOPTER_EMAIL=sarah@example.com
VITE_DEMO_ADOPTER_PASSWORD=replace_with_demo_adopter_password
