NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://replace-with-cloudfront-domain.example

DB_HOST=database
DB_PORT=3306
DB_USER=pawconnect_app
DB_PASSWORD=replace_with_a_unique_production_database_password
DB_NAME=pawconnect
DB_NAME_TEST=pawconnect_test
MYSQL_ROOT_PASSWORD=replace_with_a_unique_production_root_password

JWT_SECRET=replace_with_a_random_secret_of_at_least_64_characters
ADMIN_EMAIL=admin@pawconnect.edu
ADMIN_PASSWORD=replace_with_a_unique_production_admin_password
DEMO_ADOPTER_EMAIL=sarah@example.com
DEMO_ADOPTER_PASSWORD=replace_with_a_unique_production_adopter_password

EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=supportpawconnect@gmail.com
SMTP_APP_PASSWORD=replace_with_google_app_password
EMAIL_FROM=PawConnect Support <supportpawconnect@gmail.com>
SUPPORT_EMAIL=supportpawconnect@gmail.com

VITE_API_URL=/api
VITE_ENABLE_DEMO_LOGIN=false

WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=80
